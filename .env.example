# Local Postgres from docker-compose.yml (host port 5433).
DATABASE_URL=postgres://trace:trace@localhost:5433/trace
DATABASE_URL_TEST=postgres://trace:trace@localhost:5433/trace_test

# Signs the demo session cookie. At least 32 characters; use a random value outside local dev.
SESSION_SECRET=local-dev-session-secret-change-me-0000

# Stripe test mode — required; the web app and worker refuse to start without them.
# STRIPE_SECRET_KEY: Dashboard → Developers → API keys (sk_test_…; live keys are rejected).
# STRIPE_WEBHOOK_SECRET: printed by `stripe listen` (whsec_…). See README.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Increase — optional until that integration lands.
INCREASE_API_KEY=
INCREASE_WEBHOOK_SECRET=

# trace | debug | info | warn | error | silent
LOG_LEVEL=info
